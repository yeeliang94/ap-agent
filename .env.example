# Copy this file to .env and fill in real values. .env is git-ignored.

# Local development: a direct OpenAI key.
OPENAI_API_KEY=

# Windows enterprise: set the shared proxy URL and use catalogue model IDs.
# When LLM_PROXY_URL is set, all model calls route through it.
LLM_PROXY_URL=

# Which model handles each pipeline role. Locally these are OpenAI names;
# on Windows they must be IDs from the enterprise catalogue (config/models.json).
SORT_MODEL=gpt-4o-mini
EXTRACT_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

# Where reference documents (payment listing, policy sheet, bank template)
# come from: "local" = samples folder, "mcp" = SharePoint MCP contract.
DOC_SOURCE=local
MCP_URL=http://127.0.0.1:8003

# How to talk to the SharePoint service:
#   rest = the bespoke contract the local fake_mcp/server.py implements
#   mcp  = the real Model Context Protocol (streamable HTTP). Use this on
#          Windows against the enterprise gateway; MCP_URL must then be
#          the MCP endpoint itself, e.g. .../mcp/sharepointmcp
MCP_PROTOCOL=rest

# Auth for the enterprise MCP gateway. Leave BOTH blank for the local
# fake. The PwC LiteLLM gateway documents:
#   MCP_AUTH_HEADER=x-litellm-api-key
#   MCP_AUTH_VALUE=Bearer <your-LiteLLM-API-key>
# Note this is the GATEWAY credential; the Microsoft Graph/Entra delegated
# sign-in for SharePoint itself is separate.
MCP_AUTH_HEADER=
MCP_AUTH_VALUE=

# Optional: pin exact tool names when discovery cannot decide. Run
# backend/scripts/mcp_probe.py to see what the server actually offers.
MCP_TOOL_RESOLVE_FOLDER=
MCP_TOOL_LIST_ITEMS=
MCP_TOOL_GET_DOCUMENT=
SHAREPOINT_FOLDER_URL=https://example.sharepoint.com/sites/clientabc/Shared%20Documents/AP%20Reference
