# Copy this file to .env and fill in real values. .env is git-ignored.

# Local development: a direct OpenAI key.
OPENAI_API_KEY=

# Windows enterprise: set the shared proxy URL and use catalogue model IDs.
# When LLM_PROXY_URL is set, all model calls route through it.
LLM_PROXY_URL=

# Which model handles each pipeline role. Locally these are OpenAI names;
# on Windows they must be IDs from the enterprise catalogue (config/models.json).
SORT_MODEL=gpt-4o-mini
EXTRACT_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

# Where reference documents (payment listing, policy sheet, bank template)
# come from: "local" = samples folder, "mcp" = SharePoint MCP contract.
DOC_SOURCE=local
MCP_URL=http://127.0.0.1:8003

# How to talk to the SharePoint service:
#   rest = the bespoke contract the local fake_mcp/server.py implements
#   mcp  = the real Model Context Protocol (streamable HTTP). Use this on
#          Windows against the enterprise gateway; MCP_URL must then be
#          the MCP endpoint itself, e.g. .../mcp/sharepointmcp
MCP_PROTOCOL=rest

# Auth for the enterprise MCP gateway. Leave BOTH blank for the local
# fake. The PwC LiteLLM gateway documents:
#   MCP_AUTH_HEADER=x-litellm-api-key
#   MCP_AUTH_VALUE=Bearer <your-LiteLLM-API-key>
# Note this is the GATEWAY credential; the Microsoft Graph/Entra delegated
# sign-in for SharePoint itself is separate.
MCP_AUTH_HEADER=
MCP_AUTH_VALUE=

# Delegated Entra sign-in, on top of the gateway credential above. The
# enterprise gateway wants both: its API key says WHICH APP is calling,
# this says WHICH PERSON it acts for. Set to true on Windows.
#
# The sign-in happens once, from the "Connect SharePoint" button on the
# runs screen — never during a run, because a background run must not
# open a browser window nobody is watching. On Windows the result is
# stored encrypted with DPAPI (tied to your Windows account) at
# %LOCALAPPDATA%\ap-agent\sharepoint-oauth-state.bin.
MCP_OAUTH=false
# Scope to request. Blank lets the gateway decide, which is usually right
# because it registers this app dynamically.
MCP_OAUTH_SCOPE=
# Where the browser returns after sign-in. Must match a redirect URI the
# gateway accepts; change only if 8766 is taken on the Windows machine.
MCP_OAUTH_CALLBACK_PORT=8766
MCP_OAUTH_CLIENT_NAME=AP Assistant

# Optional: pin exact tool names when discovery cannot decide. Run
# backend/scripts/mcp_probe.py to see what the server actually offers.
# Leave MCP_TOOL_RESOLVE_FOLDER blank for the enterprise gateway — it has
# no resolve-folder tool, and the app navigates site -> libraries ->
# items from SHAREPOINT_FOLDER_URL instead.
MCP_TOOL_RESOLVE_FOLDER=
MCP_TOOL_LIST_ITEMS=
MCP_TOOL_GET_DOCUMENT=

# The folder holding the three reference files. Copy the whole address
# from your browser while standing IN that folder — both the plain form
# and the "Forms/AllItems.aspx?id=..." form are understood.
SHAREPOINT_FOLDER_URL=https://example.sharepoint.com/sites/clientabc/Shared%20Documents/AP%20Reference
